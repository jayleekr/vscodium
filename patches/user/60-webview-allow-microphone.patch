# HypeProof Studio — allow the chat webview to request the microphone.
#
# THREE HUNKS, and the third is why v1 of this patch shipped a broken app.
#
# `pre/index.html` carries the SHA-256 of its own inline script inside its own CSP
# meta tag (`script-src 'sha256-…'`). v1 edited a line INSIDE that script and left
# the hash alone, so Chromium refused to execute it, the webview shell never built
# its content iframe, and the chat and start pages came up BLANK. Codex caught it
# on the artifact from build run 34616771276 and reported the exact Chromium error.
#
# The hash here was not guessed. The calculation was first validated by
# reproducing the stock hash from the unmodified file, and the resulting value for
# the patched script matches the hash Chromium itself reported:
#   before sha256-TaWGDzV7c9rUH2q/5ygOyYUHSyHIqBMYfucPh3lnKvU=
#   after  sha256-F3cWHVJseSLSGcewJCgf4+lHqww+TPBT0lgjBiFyf7c=
#
# ORDER MATTERS: compute the hash from the script AFTER the allowRules edit, then
# write it into the CSP meta. The meta tag sits outside the script element, so
# writing it does not perturb the hash again — asserted when generating this patch.
#
# ANY future edit inside that script invalidates this hash again and the symptom is
# a blank webview with no obvious cause. scripts/check-webview-csp-hash.py exists to
# make that a build failure instead of a silent ship.
#
# GATES (the first two are in different files; either alone changes nothing):
#   1 iframe Permissions-Policy   webview/browser/pre/index.html
#   2 Electron permission handler code/electron-main/app.ts — 'media'
#   3 the OS — not patchable; NSMicrophoneUsageDescription is already present
# Measured: allowedPermissionsInCore ALREADY has 'media', so the workbench window
# may use the microphone today. Only webview frames may not.
#
# WHICH GATE DENIES IS UNKNOWN. The inner frame is same-origin (allow-same-origin,
# loaded from fake.html on the webview origin) and microphone's default allowlist
# is 'self'; MDN does not state whether an allow attribute that omits a feature
# disables it. So hunk 1 may be unnecessary and hunk 2 may be the load-bearing one.
# Only a build settles it. Do not record this patch as "microphone works".
#
# BLAST RADIUS — read before shipping. Hunk 1 is keyed on options.allowScripts, the
# same trust level clipboard-read uses, because upstream webview options carry no
# media flag. Every script-enabled webview may then REQUEST the microphone, subject
# to the OS prompt. Narrowing that to one webview means plumbing a new webview
# option through the options type and the serialising host.
#
# Generated from microsoft/vscode at 560a9dba96f9 (upstream/stable.json tag 1.116.0).
--- a/src/vs/workbench/contrib/webview/browser/pre/index.html
+++ b/src/vs/workbench/contrib/webview/browser/pre/index.html
@@ -5,7 +5,7 @@
 	<meta charset="UTF-8">
 
 	<meta http-equiv="Content-Security-Policy"
-		content="default-src 'none'; script-src 'sha256-TaWGDzV7c9rUH2q/5ygOyYUHSyHIqBMYfucPh3lnKvU=' 'self'; frame-src 'self'; style-src 'unsafe-inline';">
+		content="default-src 'none'; script-src 'sha256-F3cWHVJseSLSGcewJCgf4+lHqww+TPBT0lgjBiFyf7c=' 'self'; frame-src 'self'; style-src 'unsafe-inline';">
 
 	<!-- Disable pinch zooming -->
 	<meta name="viewport"
@@ -1055,7 +1055,7 @@
 
 				const allowRules = ['cross-origin-isolated;', 'autoplay;', 'local-network-access;'];
 				if (!isFirefox && options.allowScripts) {
-					allowRules.push('clipboard-read;', 'clipboard-write;');
+					allowRules.push('clipboard-read;', 'clipboard-write;', 'microphone;');
 				}
 				newFrame.setAttribute('allow', allowRules.join(' '));
 				// We should just be able to use srcdoc, but I wasn't
--- a/src/vs/code/electron-main/app.ts
+++ b/src/vs/code/electron-main/app.ts
@@ -194,6 +194,11 @@
 
 		const allowedPermissionsInWebview = new Set([
 			...alwaysAllowedPermissions,
+			// HypeProof: 'media' is Electron's camera/microphone/speaker permission.
+			// The iframe Permissions-Policy in webview/browser/pre/index.html must also
+			// allow 'microphone' for a frame, and the OS prompt still runs, so this alone
+			// grants nothing. allowedPermissionsInCore below already contains 'media'.
+			'media',
 			'clipboard-read',
 			'clipboard-sanitized-write',
 			// TODO(deepak1556): Should be removed once migration is complete
